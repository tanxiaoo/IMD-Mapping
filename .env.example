# Copy this file to .env and fill in your own values. .env is gitignored, so
# each person's settings stay local and a pull never overwrites them.
#
#   cp .env.example .env      # or, on Windows: copy .env.example .env
#
# Your Google Cloud project registered for Earth Engine. Find it at
# https://console.cloud.google.com/project -- it is the project id, not the
# display name, and it is what ee.Initialize(project=...) takes.
GEE_PROJECT=your-cloud-project-id
