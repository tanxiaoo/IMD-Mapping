# latexmk configuration for report.tex.
#
# The PDF is written next to report.tex; the ~8 auxiliary files LaTeX needs
# (.aux, .log, .out, .xdv, .fls, .fdb_latexmk) go to build/ so they do not
# clutter the report directory. Both are set here rather than passed on the
# command line, so `latexmk` with no arguments does the right thing.
$pdf_mode = 5;              # 5 = xelatex (the report needs it: U+2212, mid dots)
$aux_dir  = 'build';
$out_dir  = '.';
$emulate_aux = 1;           # MiKTeX resolves \label across a split aux/out dir

# BibTeX runs on build/report.aux with build/ as its working directory, so a
# bare \bibdata{refs} resolves against build/ and refs.bib -- which sits here
# beside report.tex -- is not found. Without this the build produces no PDF at
# all: bibtex exits non-zero and latexmk stops. A stale build/report.bbl hides
# the failure for as long as it survives, so the symptom appears only after a
# clean, which is why this went unnoticed until build/ was cleared.
#
# latexmk sets BIBINPUTS itself, but under a POSIX shell on Windows (Git Bash,
# MSYS) it writes MSYS-style '/d/...' paths that MiKTeX's bibtex cannot read,
# and joins them with ':' where Windows expects ';'. Setting it last, to a
# path relative to bibtex's own working directory, avoids both problems: '..'
# needs no translation and no separator. The trailing ';' keeps MiKTeX's
# default search path.
#
# $force_mode is not a substitute. The bibliography would silently come out
# empty and every \cite would render as [?].
$ENV{'BIBINPUTS'} = '..;';
